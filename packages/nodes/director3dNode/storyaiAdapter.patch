+.shortcutHelp h2 { margin: 0; font-size: 15px; }
+.shortcutHelp header button { display: grid; place-items: center; width: 28px; height: 28px; border: 0; border-radius: 50%; background: #ffffff0e; color: inherit; }
+.shortcutHelp section > div { min-height: 32px; font-size: 13px; }
+.shortcutHelp .shortcutProfiles { gap: 3px; padding: 3px; margin-bottom: 8px; background: #ffffff09; border-radius: 12px; }
+.shortcutProfiles button { flex: 1; border: 0; border-radius: 9px; padding: 6px; background: transparent; color: #b2b3bb; cursor: pointer; }
+.shortcutProfiles button[aria-pressed="true"] { color: white; background: #ffffff18; }
+
+@media (max-width: 920px) {
+  .top-bar { grid-template-columns: min(220px, 28vw) minmax(0, 1fr); }
+}
+
+.studioDesk {
+  --studioPanel: rgb(var(--panel-rgb));
+  --studioInset: rgb(var(--field-rgb));
+  --studioLine: rgb(var(--text-rgb) / .09);
+  --studioShadow: 0 6px 24px rgb(0 0 0 / .17), 0 1px 3px rgb(0 0 0 / .08);
+  --left-sidebar-width: 280px;
+  --right-sidebar-width: 288px;
+  --right-sidebar-content-width: 100%;
+  font-family: Inter, "Microsoft YaHei UI", system-ui, sans-serif;
+}
+:root:not(.dark) .studioDesk {
+  --panel-rgb: 250 250 252;
+  --surface-rgb: 241 242 245;
+  --field-rgb: 233 235 239;
+  --surface-hover-rgb: 222 225 231;
+}
+.studioDesk .top-bar-left { margin: 12px 0 0 12px; width: fit-content; height: 42px; padding: 0 17px 0 44px; border: 1px solid var(--studioLine); border-radius: 16px; background: var(--studioPanel); box-shadow: var(--studioShadow); }
+.studioDesk .top-bar-actions { display: flex; left: 18px; top: 18px; }
+.studioDesk .top-bar-action-button { border: 0; border-radius: 11px; background: var(--studioInset); }
+.studioDesk .top-bar-title { color: rgb(var(--text-rgb)); font-size: 12px; }
+.studioDesk .top-bar-center .mode-toggle { border: 1px solid var(--studioLine); background: var(--studioPanel); box-shadow: var(--studioShadow); border-radius: 24px; }
+.studioDesk .mode-toggle .mode-toggle-button { border: 0; border-radius: 18px; }
+.studioDesk .mode-toggle .mode-toggle-button[aria-pressed="true"] { background: rgb(var(--accent-rgb) / .16); color: rgb(var(--text-rgb)); }
+.studioDesk .director-shell-fullbleed > .left-sidebar { left: 12px; top: 66px; bottom: 14px; grid-template-columns: 44px minmax(0,1fr); column-gap: 8px; grid-template-rows: auto minmax(0,1fr); border: 0; background: transparent; overflow: visible; pointer-events: none; }
+.studioDesk .sideRail { align-items: stretch; padding: 0; border: 0; z-index: 2; pointer-events: none; }
+.categoryDock, .studioDesk .sideRail .helpTrigger { padding: 4px; border: 1px solid var(--studioLine); border-radius: 18px; background: var(--studioPanel); box-shadow: var(--studioShadow); pointer-events: auto; }
+.categoryDock { display: grid; justify-items: center; gap: 4px; }
+.studioDesk .sideRail button { width: 34px; height: 36px; border-radius: 12px; color: rgb(var(--text-muted-rgb)); }
+.studioDesk .sideRail button:is(:hover, :focus-visible, [aria-pressed="true"]) { background: rgb(var(--accent-rgb) / .15); color: rgb(var(--text-rgb)); }
+.studioDesk .sideRail .helpTrigger { width: 38px; height: 38px; align-self: center; }
+.studioDesk .sidePage, .studioDesk .sceneTree { pointer-events: auto; background: var(--studioPanel); border: 1px solid var(--studioLine); border-radius: 20px; box-shadow: var(--studioShadow); }
+.studioDesk .sidePage { align-self: start; max-height: 100%; padding: 15px 12px; }
+.studioDesk .sidePage h2 { color: rgb(var(--text-rgb)); margin: 0 0 12px; font-size: 14px; }
+.studioDesk .sidePage[data-section="场景"] { border-radius: 20px 20px 0 0; border-bottom: 0; box-shadow: none; padding: 14px 14px 8px; }
+.studioDesk .sidePage[data-section="场景"] h2 { margin: 0; }
+.studioDesk .sceneTree { align-self: start; max-height: 100%; border-top: 0; border-radius: 0 0 20px 20px; }
+.studioDesk .object-tree-panel { width: 100%; padding: 4px 12px 14px; background: transparent; }
+.studioDesk .object-tree-groups { gap: 14px; }
+.studioDesk .object-tree-group h3 { display: flex; align-items: center; gap: 7px; font-size: 11px; color: rgb(var(--text-muted-rgb)); }
+.groupCount { font-size: 10px; font-variant-numeric: tabular-nums; opacity: .72; }
+.studioDesk .object-list { margin: 0; gap: 2px; }
+.studioDesk .object-row { min-height: 34px; grid-template-columns: minmax(0,1fr) 21px 21px; gap: 3px; padding: 0 6px; border-radius: 10px; }
+.studioDesk .object-row[aria-selected="true"] { background: rgb(var(--accent-rgb) / .16); box-shadow: inset 2px 0 rgb(var(--accent-rgb)); }
+.studioDesk .director-shell-fullbleed > .right-sidebar { top: 14px; right: 12px; bottom: 14px; height: fit-content; max-height: calc(100% - 28px); border: 1px solid var(--studioLine); border-radius: 22px; background: var(--studioPanel); box-shadow: var(--studioShadow); }
+.studioDesk .right-inspector { width: 100%; padding: 16px; background: transparent; }
+.studioDesk .right-inspector-header { height: auto; min-height: 30px; border: 0; }
+.studioDesk .right-inspector-title { font-size: 15px; letter-spacing: .01em; }
+.studioDesk .right-inspector-content { width: 100%; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 12px; padding-bottom: 0; }
+.studioDesk .right-inspector-content :is(.inspector-section, .inspector-field, .inspector-section-body) { min-width: 0; max-width: 100%; }
+.studioDesk .right-sidebar { --right-sidebar-content-width: 100%; }
+.studioDesk .right-inspector .inspector-field { grid-template-columns: minmax(0, 1fr); }
+.studioDesk .right-inspector :is(.inspector-axis-row, .inspector-color-row) { width: 100%; min-width: 0; max-width: 100%; }
+.studioDesk .right-inspector .inspector-axis-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.studioDesk .right-inspector .inspector-axis-input { width: 100%; min-width: 0; grid-template-columns: auto minmax(0, 1fr); }
+.studioDesk .right-inspector .inspector-axis-value { width: 100%; min-width: 0; }
+.studioDesk .right-inspector-content > .inspector-section { padding: 10px; border: 1px solid var(--studioLine); border-radius: 14px; }
+.studioDesk .right-inspector-tabs { gap: 3px; padding: 3px; height: auto; background: var(--studioInset); border-radius: 12px; }
+.studioDesk .right-inspector-tabs button { flex: 1; height: 29px; border-radius: 9px; }
+.studioDesk .right-inspector-tabs button[aria-pressed="true"] { background: var(--studioPanel); color: rgb(var(--text-rgb)); }
+.studioDesk .right-inspector-tabs button[aria-pressed="true"]::after { display: none; }
+.studioDesk .sideChoice, .studioDesk .sidePage summary { background: var(--studioInset); color: rgb(var(--text-rgb)); margin-top: 4px; border-radius: 11px; }
+.studioDesk .viewport-toolbar, .studioDesk .quickGroup[open] > div, .studioDesk .shortcutHelp { background: var(--studioPanel); color: rgb(var(--text-rgb)); border: 1px solid var(--studioLine); box-shadow: var(--studioShadow); }
+.studioDesk .viewport-toolbar { border-radius: 18px; padding: 5px; }
+.studioDesk .quickGroup > summary, .studioDesk .quickGroup[open] > div button, .studioDesk .shortcutProfiles button { color: rgb(var(--text-muted-rgb)); }
+.studioDesk .shortcutProfiles, .studioDesk .shortcutHelp header button { background: var(--studioInset); }
+.studioDesk .shortcutProfiles button[aria-pressed="true"], .studioDesk .quickGroup button[aria-pressed="true"] { background: rgb(var(--accent-rgb) / .15); color: rgb(var(--text-rgb)); }
+.studioDesk :is(button,summary):focus-visible { outline: 2px solid rgb(var(--accent-rgb)); outline-offset: 1px; }
+@media (max-width: 920px) { .studioDesk .director-shell-fullbleed > .left-sidebar { width: min(250px, 40vw); } }
+@media (max-width: 540px) { .studioDesk .director-shell-fullbleed > .left-sidebar { width: min(220px, 56vw); } }
+
+.studioDesk .right-inspector .inspector-color-row { grid-template-columns: 34px minmax(0, 1fr); }
+.studioDesk .right-inspector .inspector-color-hex { width: 100%; min-width: 0; }
+.studioDesk .right-inspector .preset-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
+.studioDesk .preset-grid button { min-width: 0; width: 100%; }
+.studioDesk .viewport-toolbar-button:disabled { opacity: .45; cursor: progress; }
+.captureNotice { position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 8px; width: max-content; max-width: min(320px, 80vw); padding: 7px 12px; border-radius: 12px; background: var(--studioPanel); box-shadow: var(--studioShadow); color: rgb(var(--text-rgb)); font-size: 12px; overflow-wrap: anywhere; }
+.captureNotice button { display: grid; place-items: center; padding: 3px; border: 0; background: transparent; color: inherit; cursor: pointer; }
