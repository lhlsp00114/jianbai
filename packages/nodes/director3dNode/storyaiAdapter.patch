 import App from "./App";
+import { useDirectorStore } from "./editor/store/directorStore";
+import { MANNEQUIN_POSE_PRESETS } from "./editor/presets/mannequinPosePresets";
+import type { DirectorObject, DirectorTransform, GeometryPrimitiveType } from "./editor/schema/directorProject";
+
+const frame = window.frameElement;
+if (frame) {
+  const initial = frame.getAttribute("data-project");
+  if (initial) useDirectorStore.getState().replaceProject(JSON.parse(initial));
+  frame.addEventListener("appenddirectorlayout", event => {
+    type Vector = DirectorTransform["position"];
+    type Item = { name: string; position: Vector; yaw: number; color: string };
+    const layout = (event as CustomEvent<{
+      characters: (Item & { pose: string })[];
+      props: (Item & { shape: GeometryPrimitiveType; scale: Vector })[];
+      cameras: { name: string; position: Vector; target: Vector; fov: number }[];
+    }>).detail;
+    const state = useDirectorStore.getState();
+    const objects = [...state.project.objects];
+    const cameras = [...state.project.cameras];
+    function makeObject(kind: DirectorObject["kind"], name: string, position: Vector, yaw = 0, scale: Vector = [1, 1, 1]): DirectorObject {
+      return { id: crypto.randomUUID(), name, kind, visible: true, locked: false, transform: { position, rotation: [0, yaw * Math.PI / 180, 0], scale } };
+    }
+    for (const item of layout.characters) {
+      const preset = MANNEQUIN_POSE_PRESETS.find(preset => preset.id === item.pose);
+      objects.push({ ...makeObject("character", item.name, item.position, item.yaw), bodyType: "mannequin", color: item.color,
+        characterRig: { rigType: "ue4-mannequin", posePresetId: item.pose, controls: { ...preset?.controls } } });
+    }
+    for (const item of layout.props) {
+      objects.push({ ...makeObject("prop", item.name, item.position, item.yaw, item.scale), geometryType: item.shape, color: item.color });
+    }
+    let activeCameraId = state.project.activeCameraId;
+    for (const item of layout.cameras) {
+      const object = makeObject("camera", item.name, item.position);
+      const id = crypto.randomUUID();
+      if (item === layout.cameras[0]) activeCameraId = id;
+      cameras.push({ id, name: item.name, transform: object.transform, fov: item.fov, targetMode: "manual", target: item.target, captures: [] });
+      objects.push({ ...object, linkedCameraId: id });
+    }
+    state.replaceProject({ ...state.project, objects, cameras, activeCameraId });
+    event.preventDefault();
+  });
+  useDirectorStore.subscribe((state, previous) => {
+    if (state.project !== previous.project) frame.dispatchEvent(new CustomEvent("projectchange", { detail: state.project }));
+  });
+}
 
